# This workflow will install Python dependencies, run tests and lint with a single version of Python
# For more information see: https://docs.github.com/en/actions/automating-builds-and-tests/building-and-testing-python

name: Flask server CI pipeline

on:
  push:
    branches: ["main", "containerize-application", "migrate-to-aws"]
  pull_request:
    branches: ["main", "containerize-application", "migrate-to-aws"]

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    services:
      mysql-test-database:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: andrei
          MYSQL_DATABASE: flaskdb_test
        ports:
          - 3306:3306
        volumes:
          - ./test_database:/docker-entrypoint-initdb.d
        options: >-
          --health-cmd="mysqladmin ping -h 127.0.0.1 --silent"
          --health-interval=10s
          --health-timeout=5s
          --health-retries=3

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Create secrets.json
        run: |
          cat <<'EOF' > secrets.json
          ${{ secrets.SECRETS_JSON }}
          EOF

      - name: Build Docker image
        run: docker build -t flask-server:latest .

      - name: Run Container
        run: docker run -d -p 5000:5000 --name=flask-server --network monitoring --restart unless-stopped flask-server:latest

      - name: Get Docker Containers
        run: docker ps -a

      - name: Import Database Schema
        run: |
          docker exec -i $(docker ps --filter "ancestor=mysql:8.0" --format "{{.Names}}") \
          mysql -u root -pandrei flaskdb_test < ./test_database/flaskdb_test.sql

      - name: SHOW MYSQL TABLES
        run: docker exec -i $(docker ps --filter "ancestor=mysql:8.0" --format "{{.Names}}") mysql -u root -pandrei -e "USE flaskdb_test; SHOW TABLES; DESCRIBE user;"

      - name: Wait for Container Startup
        run: sleep 10

      - name: Adjust MySQL Privileges
        run: docker exec -i $(docker ps --filter "ancestor=mysql:8.0" --format "{{.Names}}") mysql -u root -pandrei -e "GRANT ALL PRIVILEGES ON *.* TO 'root'@'%' WITH GRANT OPTION; FLUSH PRIVILEGES;"

      - name: Get Docker Containers
        run: docker ps -a

      - name: Get Flask Server Logs
        run: docker logs flask-server

      # - name: Check MySQL Connection
      #   run: docker exec -i flask-server mysqladmin -h host.docker.internal -u root -pandrei ping

      - name: Install Python Dependencies
        run: pip install -r requirements.txt

      - name: Run Pytest
        run: pytest --disable-warnings -q
